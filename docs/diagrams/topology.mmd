flowchart TB
    Human(["Human captain<br/>(at desk, or phone via remote-control)"])

    subgraph LeadSession["LEAD — long-running session: claude --agent lead"]
        direction TB
        LeadAI["Lead persona — the orchestrator<br/>strategy · files issues · pushes back<br/>does NOT ship code"]
        LeadMem[("memory/lead/")]
        Server{{"HTTP server (lead spawns and owns it)<br/>127.0.0.1:PORT · transient · dies when lead dies<br/>/events /permission /feed /register /shutdown"}}
        LeadAI -. reads/writes .-> LeadMem
        LeadAI ==>|"spawns and owns"| Server
    end

    subgraph CrewBox["CREW — transient one-shot subprocesses: claude -p"]
        direction TB
        Sec["security"]
        Arch["architect"]
        Back["backend"]
        Front["frontend"]
        Test["tester"]
    end

    SecMem[("memory/<br/>security/")]
    ArchMem[("memory/<br/>architect/")]
    BackMem[("memory/<br/>backend/")]
    FrontMem[("memory/<br/>frontend/")]
    TestMem[("memory/<br/>tester/")]

    Routing[["Routing layer (optional, external)<br/>Code Conductor · Agent Teams"]]

    Human ~~~ CrewBox
    Human <-->|chat| LeadAI
    LeadAI ==>|"shipmates ask / fanout (spawns crew)"| CrewBox
    CrewBox -->|"hooks: SessionStart/End,<br/>PreToolUse, Stop, PermissionRequest"| Server
    Server -->|"GET /feed (live activity)"| LeadAI
    Server -. "PermissionRequest → approve from phone / Slack" .-> Human

    Sec -. rw .-> SecMem
    Arch -. rw .-> ArchMem
    Back -. rw .-> BackMem
    Front -. rw .-> FrontMem
    Test -. rw .-> TestMem

    LeadAI -. "files issues" .-> Routing
    Routing -. "dispatches work" .-> CrewBox

    classDef transient stroke-dasharray: 5 5
    class Server,CrewBox transient
