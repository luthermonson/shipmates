  "properties":{
    "schema":{"const":"fleet.commander-message.v1"},"message_id":{"$ref":"#/$defs/id"},"delegation_id":{"$ref":"#/$defs/id"},"fleet_id":{"$ref":"#/$defs/id"},"ship_id":{"$ref":"#/$defs/id"},
    "connection_generation":{"type":"integer","minimum":1,"maximum":18446744073709551615},"direction":{"enum":["fleet_to_ship","ship_to_fleet"]},"sequence":{"type":"integer","minimum":1,"maximum":18446744073709551615},"ack":{"type":"integer","minimum":0,"maximum":18446744073709551615},"expires_at":{"$ref":"#/$defs/time"},
    "body":{"oneOf":[{"$ref":"#/$defs/offer"},{"$ref":"#/$defs/receipt"},{"$ref":"#/$defs/decision"}]}
  },
  "allOf":[
