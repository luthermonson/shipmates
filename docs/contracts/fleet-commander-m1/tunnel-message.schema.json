    {"if":{"properties":{"body":{"properties":{"type":{"enum":["delegation.receipt.v1","delegation.decision.v1"]}},"required":["type"]}},"required":["body"]},"then":{"properties":{"direction":{"const":"ship_to_fleet"}}}}
  ],
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{15,95}$","maxLength":96},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$","maxLength":64},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$","maxLength":24},
    "offer":{"type":"object","additionalProperties":false,"required":["type","envelope"],"properties":{"type":{"const":"delegation.offer.v1"},"envelope":{"$ref":"delegation-envelope.schema.json"}}},
    "receipt":{"type":"object","additionalProperties":false,"required":["type","result","reason_code","envelope_digest"],"properties":{"type":{"const":"delegation.receipt.v1"},"result":{"enum":["accepted","duplicate","rejected","expired","revoked"]},"reason_code":{"type":"string","enum":["accepted","duplicate","invalid","id_conflict","expired","opt_in_disabled","issuer_revoked","provenance_mismatch","backpressure","revoked"]},"envelope_digest":{"$ref":"#/$defs/digest"}},"allOf":[{"if":{"properties":{"result":{"const":"accepted"}},"required":["result"]},"then":{"properties":{"reason_code":{"const":"accepted"}}}},{"if":{"properties":{"result":{"const":"duplicate"}},"required":["result"]},"then":{"properties":{"reason_code":{"const":"duplicate"}}}},{"if":{"properties":{"result":{"const":"expired"}},"required":["result"]},"then":{"properties":{"reason_code":{"const":"expired"}}}},{"if":{"properties":{"result":{"const":"revoked"}},"required":["result"]},"then":{"properties":{"reason_code":{"enum":["issuer_revoked","revoked"]}}}},{"if":{"properties":{"result":{"const":"rejected"}},"required":["result"]},"then":{"properties":{"reason_code":{"enum":["invalid","id_conflict","opt_in_disabled","provenance_mismatch","backpressure"]}}}}]},
    "decision":{"type":"object","additionalProperties":false,"required":["type","result","reason_code","provenance_digest","sail_state"],"properties":{"type":{"const":"delegation.decision.v1"},"result":{"enum":["advised","rejected","expired","revoked","indeterminate"]},"reason_code":{"type":"string","enum":["advised","response_invalid","restart_after_assessment","revoked_after_start","expired","revoked"]},"advisory_decision":{"enum":["resume","continue","amendment_required","stop"]},"provenance_digest":{"$ref":"#/$defs/digest"},"sail_state":{"enum":["not_evaluated","advisory_rejected","locally_accepted_under_existing_policy"]}},"allOf":[{"if":{"properties":{"result":{"const":"advised"}},"required":["result"]},"then":{"required":["advisory_decision"],"properties":{"reason_code":{"const":"advised"},"sail_state":{"enum":["advisory_rejected","locally_accepted_under_existing_policy"]}}},"else":{"not":{"required":["advisory_decision"]},"properties":{"sail_state":{"const":"not_evaluated"}}}},{"if":{"properties":{"result":{"const":"rejected"}},"required":["result"]},"then":{"properties":{"reason_code":{"const":"response_invalid"}}}},{"if":{"properties":{"result":{"const":"expired"}},"required":["result"]},"then":{"properties":{"reason_code":{"const":"expired"}}}},{"if":{"properties":{"result":{"const":"revoked"}},"required":["result"]},"then":{"properties":{"reason_code":{"enum":["revoked","revoked_after_start"]}}}},{"if":{"properties":{"result":{"const":"indeterminate"}},"required":["result"]},"then":{"properties":{"reason_code":{"const":"restart_after_assessment"}}}}]}
  }
