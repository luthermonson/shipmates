{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delegation-envelope.schema.json",
  "title": "fleet.delegation-envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","delegation_id","issuer_key_id","fleet_id","ship_id","voyage_plan_hash","task_contract_hash","state_hash","task_id","blocker_fingerprint","mode","assessment_budget","response_schema","references","issued_at","expires_at","signature"],
  "properties": {
    "schema":{"const":"fleet.delegation-envelope.v1"},
    "delegation_id":{"$ref":"#/$defs/id"},
    "issuer_key_id":{"$ref":"#/$defs/id"},
    "fleet_id":{"$ref":"#/$defs/id"}, "ship_id":{"$ref":"#/$defs/id"},
    "voyage_plan_hash":{"$ref":"#/$defs/digest"}, "task_contract_hash":{"$ref":"#/$defs/digest"}, "state_hash":{"$ref":"#/$defs/digest"},
    "task_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,95}$","maxLength":96},
    "blocker_fingerprint":{"$ref":"#/$defs/digest"},
    "mode":{"const":"read_only_recovery_assessment"}, "assessment_budget":{"const":1}, "response_schema":{"const":"recovery.response.v1"},
    "references":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/reference"}},
    "issued_at":{"$ref":"#/$defs/time"}, "expires_at":{"$ref":"#/$defs/time"},
    "signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$","maxLength":86}
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{15,95}$","maxLength":96},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$","maxLength":64},
    "time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$","maxLength":24},
    "reference":{"type":"object","additionalProperties":false,"required":["kind","digest"],"properties":{"kind":{"type":"string","enum":["recovery_evidence_ref","evidence_certificate_ref"]},"digest":{"$ref":"#/$defs/digest"}}}
  }
}
